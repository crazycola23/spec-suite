{
  "_comment": "模板：拷到规格库根目录，把 <项目代号> 换成真名。把本 skill 的 guard/migration/checker/generator/verifier 脚本拷进仓库自身，不引用相邻 skill 目录。",
  "name": "<项目代号>-specs",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/check-spec-suite.mjs --specs-root . --config spec-suite.config.json",
    "fix:generated-regions": "node scripts/check-spec-suite.mjs --specs-root . --config spec-suite.config.json --write-generated-regions",
    "generate:bundle": "node scripts/generate-contract-bundle.mjs --specs-root . --config spec-suite.config.json",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "yaml": "^2"
  }
}
